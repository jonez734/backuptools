#
# htaccess-dev - Development rewrite rules for BACKUPTOOLS
#

AuthName "backuptoolsdev"
AuthType Basic
AuthBasicProvider file
AuthUserFile /srv/www/vhosts/backtoolsdev.zoidtechnologies.com/80/html/.htpasswd
Require valid-user

RewriteEngine On

RewriteBase /

RewriteRule ^favicon\.ico$ - [last]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)$ index.php?uri=$1 [last,qsappend]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+) index.php/$1 [last]

RewriteRule ^$ index.php [last]
